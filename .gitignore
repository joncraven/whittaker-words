# Byte-compiled Emacs artifacts (regenerated by install.sh / byte-compile)
*.elc

# Emacs autosave / lock / transient files
#*#
*~
.\#*
/\#*
.\#lock*

# Dictionary database and its WAL/shadow files (built locally by install.sh;
# ~294 MB — never committed). Users build it on first run.
*.db
*.db-wal
*.db-shm
whittakers.db

# Whitaker's Words upstream dictionary source data (cloned at install time).
# Not shipped: fetched from https://github.com/mk270/whitakers-words.
whitakers-words-src/
DICTLINE.*
INFLECTS.*
UNIQUES.*

# Python build / test caches
__pycache__/
*.pyc
*.pyo
.mypy_cache/
.pytest_cache/
.ruff_cache/
.venv/
.venv-*/

# OS / editor junk
.DS_Store
Thumbs.db

# Local secrets — never commit
.env
*.local
